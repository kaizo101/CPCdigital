{
  "name": "cpcdigital",
  "productName": "CPCdigital",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n vite,electron -c blue,green \"npm run dev -w @cpc/client\" \"wait-on http://localhost:5173 && npm run dev -w @cpc/electron\"",
    "electron:dev": "npm run build -w @cpc/electron && electron packages/electron",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "calibrate:bots": "tsx packages/client/src/simulation.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^41.1.1",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  }
}
