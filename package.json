{
  "name": "cpcdigital",
  "productName": "CPCdigital",
  "private": true,
  "version": "0.8.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0 <26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "./start.sh",
    "predev": "node scripts/check-runtime.mjs",
    "dev": "concurrently -n vite,electron -c blue,green \"npm run dev -w @cpc/client\" \"wait-on http://localhost:5173 && npm run dev -w @cpc/electron\"",
    "electron:dev": "npm run build -w @cpc/electron && electron packages/electron",
    "package:linux:internal": "npm run build -w @cpc/client && npm run build -w @cpc/electron && electron-builder --linux AppImage --config electron-builder.config.cjs --publish never",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:calibration": "node --import tsx scripts/calibration-regression.ts",
    "calibrate:release": "node --import tsx scripts/calibration-release.ts",
    "test:stakes": "node --import tsx scripts/stake-invariance.ts",
    "calibrate:baseline": "node --import tsx scripts/calibration-regression.ts --update",
    "test:responsive": "node scripts/responsive-smoke.mjs",
    "calibrate:bots": "node --import tsx packages/client/src/simulation.ts",
    "android:sync": "npm run build -w @cpc/client && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:gradle": "node scripts/android-gradle.mjs",
    "android:check": "npm run android:sync && npm run android:gradle"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "concurrently": "^8.2.0",
    "electron": "41.10.7",
    "electron-builder": "26.17.0",
    "typescript": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "esbuild@0.28.1": true,
    "bcrypt@6.0.0": true,
    "better-sqlite3@12.11.1": true
  }
}
